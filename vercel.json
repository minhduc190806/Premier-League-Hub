{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/fpl-bootstrap",
      "destination": "https://fantasy.premierleague.com/api/bootstrap-static/"
    },
    {
      "source": "/api/fpl-fixtures",
      "destination": "https://fantasy.premierleague.com/api/fixtures/"
    }
  ]
}
